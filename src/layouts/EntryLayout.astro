---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  image?: string;
}

const { title, description, date, image } = Astro.props;
const formattedDate = date.toISOString().slice(0, 10);
const isProject = Astro.url.pathname.startsWith('/projects');
const backLink = isProject ? '/projects/' : '/notes/';
const backText = isProject ? '← Projects 목록' : '← Notes 목록';
---

<BaseLayout {title} {description} {image} type="article">
  <article class="entry">
    <header>
      <p><time datetime={date.toISOString()}>{formattedDate}</time></p>
      <h1>{title}</h1>
      <p>{description}</p>
    </header>
    <div class="entry-body">
      <slot />
    </div>
    <footer class="entry-footer">
      <a href={backLink}>{backText}</a>
    </footer>
  </article>
</BaseLayout>
