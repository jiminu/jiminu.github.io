---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const projectsByYear = projects.reduce<Record<number, typeof projects>>((acc, project) => {
  const year = project.data.date.getFullYear();
  (acc[year] ??= []).push(project);
  return acc;
}, {});

const years = Object.keys(projectsByYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<BaseLayout title="Projects" description="프로젝트 기록">
  <h1>Projects</h1>
  {years.length === 0 ? (
    <p class="empty">아직 공개한 프로젝트가 없습니다.</p>
  ) : (
    years.map((year) => (
      <section class="archive-group">
        <h2>{year}</h2>
        <ul class="entry-list">
          {projectsByYear[year].map((project) => (
            <li class:list={{ 'has-thumbnail': project.data.thumbnail }}>
              <div>
                <time datetime={project.data.date.toISOString()}>
                  {project.data.date.toISOString().slice(5, 10)}
                </time>
                <a href={`/projects/${project.id}/`}>{project.data.title}</a>
                <p>{project.data.description}</p>
              </div>
              {project.data.thumbnail && (
                <a
                  class="entry-thumbnail"
                  href={`/projects/${project.id}/`}
                  aria-label={`${project.data.title} 프로젝트 보기`}
                >
                  <img
                    src={project.data.thumbnail}
                    alt=""
                    width="112"
                    height="72"
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))
  )}
</BaseLayout>
