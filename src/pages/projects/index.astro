---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Projects" description="프로젝트 기록">
  <h1>Projects</h1>
  {projects.length === 0 ? (
    <p class="empty">아직 공개한 프로젝트가 없습니다.</p>
  ) : (
    <ul class="entry-list">
      {projects.map((project) => (
        <li class:list={{ 'has-thumbnail': project.data.thumbnail }}>
          <div>
            <time datetime={project.data.date.toISOString()}>
              {project.data.date.toISOString().slice(0, 10)}
            </time>
            <a href={`/projects/${project.id}/`}>{project.data.title}</a>
            <p>{project.data.description}</p>
          </div>
          {project.data.thumbnail && (
            <a
              class="entry-thumbnail"
              href={`/projects/${project.id}/`}
              aria-label={`${project.data.title} 프로젝트 보기`}
            >
              <img
                src={project.data.thumbnail}
                alt=""
                width="112"
                height="72"
                loading="lazy"
                decoding="async"
              />
            </a>
          )}
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
