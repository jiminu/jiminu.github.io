---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  const allNotes = await getCollection('notes', ({ data }) => !data.draft);

  return projects.map((entry) => {
    const relatedNotes = (entry.data.notes ?? [])
      .map((noteId) => allNotes.find((n) => n.id === noteId))
      .filter((n): n is CollectionEntry<'notes'> => Boolean(n))
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

    return {
      params: { id: entry.id },
      props: { entry, relatedNotes },
    };
  });
}

interface Props {
  entry: CollectionEntry<'projects'>;
  relatedNotes: CollectionEntry<'notes'>[];
}

const { entry, relatedNotes } = Astro.props;
const { Content } = await render(entry);
---

<EntryLayout
  title={entry.data.title}
  description={entry.data.description}
  date={entry.data.date}
  image={entry.data.thumbnail}
  relatedNotes={relatedNotes}
>
  <Content />
</EntryLayout>
