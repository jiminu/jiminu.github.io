---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const byNewest = (a: { data: { date: Date } }, b: { data: { date: Date } }) =>
  b.data.date.valueOf() - a.data.date.valueOf();

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort(byNewest)
  .slice(0, 5);
const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort(byNewest)
  .slice(0, 5);
---

<BaseLayout>
  <section class="intro">
    <h1>jiminu</h1>
    <p>개인 프로젝트와 기술 기록.</p>
  </section>

  <section>
    <header class="section-heading">
      <h2>Projects</h2>
      <p>구현한 프로젝트와 결과</p>
    </header>
    {projects.length === 0 ? (
      <p class="empty">아직 공개한 프로젝트가 없습니다.</p>
    ) : (
      <ul class="entry-list">
        {projects.map((project) => (
          <li class:list={{ 'has-thumbnail': project.data.thumbnail }}>
            <div>
              <time datetime={project.data.date.toISOString()}>
                {project.data.date.toISOString().slice(0, 10)}
              </time>
              <a href={`/projects/${project.id}/`}>{project.data.title}</a>
              <p>{project.data.description}</p>
            </div>
            {project.data.thumbnail && (
              <a
                class="entry-thumbnail"
                href={`/projects/${project.id}/`}
                aria-label={`${project.data.title} 프로젝트 보기`}
              >
                <img
                  src={project.data.thumbnail}
                  alt=""
                  width="112"
                  height="72"
                  loading="lazy"
                  decoding="async"
                />
              </a>
            )}
          </li>
        ))}
      </ul>
    )}
  </section>

  <section>
    <header class="section-heading">
      <h2>Notes</h2>
      <p>기술 선택과 문제 해결 기록</p>
    </header>
    {notes.length === 0 ? (
      <p class="empty">아직 작성한 글이 없습니다.</p>
    ) : (
      <ul class="entry-list">
        {notes.map((note) => (
          <li>
            <time datetime={note.data.date.toISOString()}>
              {note.data.date.toISOString().slice(0, 10)}
            </time>
            <a href={`/notes/${note.id}/`}>{note.data.title}</a>
            <p>{note.data.description}</p>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
