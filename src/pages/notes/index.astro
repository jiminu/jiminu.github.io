---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const notesByYear = notes.reduce<Record<number, typeof notes>>((acc, note) => {
  const year = note.data.date.getFullYear();
  (acc[year] ??= []).push(note);
  return acc;
}, {});

const years = Object.keys(notesByYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<BaseLayout title="Notes" description="기술 기록">
  <h1>Notes</h1>
  {years.length === 0 ? (
    <p class="empty">아직 작성한 글이 없습니다.</p>
  ) : (
    years.map((year) => (
      <section class="archive-group">
        <h2>{year}</h2>
        <ul class="note-list">
          {notesByYear[year].map((note) => (
            <li>
              <time datetime={note.data.date.toISOString()}>
                {note.data.date.toISOString().slice(5, 10)}
              </time>
              <a href={`/notes/${note.id}/`}>{note.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ))
  )}
</BaseLayout>
