---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  const allProjects = await getCollection('projects', ({ data }) => !data.draft);

  return notes.map((entry) => {
    const relatedProject = allProjects.find((project) =>
      project.data.notes?.includes(entry.id)
    );

    return {
      params: { id: entry.id },
      props: { entry, relatedProject },
    };
  });
}

interface Props {
  entry: CollectionEntry<'notes'>;
  relatedProject?: CollectionEntry<'projects'>;
}

const { entry, relatedProject } = Astro.props;
const { Content } = await render(entry);
---

<EntryLayout
  title={entry.data.title}
  description={entry.data.description}
  date={entry.data.date}
  relatedProject={relatedProject}
>
  <Content />
</EntryLayout>
