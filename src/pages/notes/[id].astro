---
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);

  return Promise.all(
    notes.map(async (entry) => {
      const project = entry.data.project
        ? await getEntry(entry.data.project)
        : undefined;
      const relatedProject =
        project && !project.data.draft ? project : undefined;

      return {
        params: { id: entry.id },
        props: { entry, relatedProject },
      };
    })
  );
}

interface Props {
  entry: CollectionEntry<'notes'>;
  relatedProject?: CollectionEntry<'projects'>;
}

const { entry, relatedProject } = Astro.props;
const { Content } = await render(entry);
---

<EntryLayout
  title={entry.data.title}
  description={entry.data.description}
  date={entry.data.date}
  relatedProject={relatedProject}
>
  <Content />
</EntryLayout>
